digraph CFG {
  graph [label="scholarship(gpa, credits, hasViolation) — CFG  |  JaCoCo short-circuit branches", labelloc="t", fontsize=22, fontname="DejaVu Sans", pad="0.5", ranksep="0.65 equally", nodesep="0.4", splines="polyline", bgcolor="white"];
  node [fontname="DejaVu Sans", shape=diamond, style="rounded,filled", fillcolor="#f2f6fb", color="#366282", fontsize=12, penwidth=1.5];
  edge [fontname="DejaVu Sans", fontsize=9, color="#34495e", arrowsize=0.7];
  entry [label="START", shape=oval, fillcolor="#dff5e9"];
  G1 [label="gpa < 0?"];
  G2 [label="gpa > 4?"];
  G3 [label="credits < 0?"];
  X [label="throw IllegalArgumentException", shape=box, fillcolor="#ffe7e7"];
  V [label="hasViolation?"];
  H1 [label="gpa >= 3.8?"];
  H2 [label="credits >= 15?"];
  M1 [label="gpa >= 3.4?"];
  M2 [label="credits >= 12?"];
  L [label="gpa >= 3.0?"];
  Z [label="return 0", shape=box, fillcolor="#fff2da"];
  R100 [label="return 100", shape=box, fillcolor="#e3f7e4"];
  R70 [label="return 70", shape=box, fillcolor="#e3f7e4"];
  R50 [label="return 50", shape=box, fillcolor="#e3f7e4"];
  entry -> G1;
  G1 -> X [label="T: scholarship_negativeGpa_throws"];
  G1 -> G2 [label="F: scholarship_aboveFour_throws"];
  G2 -> X [label="T: scholarship_aboveFour_throws"];
  G2 -> G3 [label="F: scholarship_negativeCredits_throws"];
  G3 -> X [label="T: scholarship_negativeCredits_throws"];
  G3 -> V [label="F: scholarship_violation_returnsZero"];
  V -> Z [label="T: scholarship_violation_returnsZero"];
  V -> H1 [label="F: scholarship_hundred_returnsHundred"];
  H1 -> H2 [label="T: scholarship_hundred_returnsHundred"];
  H1 -> M1 [label="F: scholarship_midTier_returnsSeventy"];
  H2 -> R100 [label="T: scholarship_hundred_returnsHundred"];
  H2 -> M1 [label="F: scholarship_topGpaCreditsFourteen_returnsSeventy"];
  M1 -> M2 [label="T: scholarship_midTier_returnsSeventy"];
  M1 -> L [label="F: scholarship_lowTier_returnsFifty"];
  M2 -> R70 [label="T: scholarship_midTier_returnsSeventy"];
  M2 -> L [label="F: scholarship_midGpaCreditsEleven_returnsFifty"];
  L -> R50 [label="T: scholarship_lowTier_returnsFifty"];
  L -> Z [label="F: scholarship_lowGpa_returnsZero"];
}
